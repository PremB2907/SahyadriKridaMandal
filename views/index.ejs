  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const headings = document.querySelectorAll(".fit-text-heading");
      
      const adjustFontSize = (heading) => {
        const parent = heading.parentElement;
        if (!parent) return;

        // Reset to max size to measure
        const maxSize = parseFloat(heading.getAttribute('data-max-size') || 40);
        let currentSize = maxSize;
        heading.style.fontSize = currentSize + 'px';

        // Available width in the parent container
        const availableWidth = parent.clientWidth - parseFloat(getComputedStyle(parent).paddingLeft) - parseFloat(getComputedStyle(parent).paddingRight);
        
        // Loop down until it fits
        while (heading.scrollWidth > availableWidth && currentSize > 10) {
          currentSize -= 0.5;
          heading.style.fontSize = currentSize + 'px';
        }
      };

      const observer = new ResizeObserver(entries => {
        for (let entry of entries) {
          headings.forEach(adjustFontSize);
        }
      });

      headings.forEach(heading => {
        if (heading.parentElement) observer.observe(heading.parentElement);
        adjustFontSize(heading);
      });
      
      // Also adjust on language change if it affects string length
      const langBtns = document.querySelectorAll('.lang-btn');
      langBtns.forEach(btn => btn.addEventListener('click', () => {
        setTimeout(() => headings.forEach(adjustFontSize), 50);
      }));
    });
  </script>

