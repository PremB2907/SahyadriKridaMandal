<%- include('partials/header') %>

  <section class="page-hero-banner">
    <div class="container">
      <h1>
        <span class="lang-mr">क्षणचित्रे व दशकातील सुवर्ण प्रवास</span>
        <span class="lang-en">Glimpses & Golden Journey of a Decade</span>
      </h1>
    </div>
  </section>

  <!-- Featured 3D Interactive Scroll Reel -->
  <section
    style="background: linear-gradient(180deg, #160303 0%, #0A0A0A 100%); padding: 3.5rem 0 2.5rem; border-bottom: 2px solid var(--royal-gold); position: relative; overflow: hidden;">
    <div class="container">
      <div
        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
        <h2
          style="font-size: 1.6rem; color: var(--gold-soft); margin: 0; display: flex; align-items: center; gap: 10px;">
          <i class="fa-solid fa-crown" style="color: var(--royal-gold);"></i>
          <span>
            <span class="lang-mr">दशकातील स्वर्णिम क्षणचित्रे (3D Retrospective Reel)</span>
            <span class="lang-en">Golden Moments of the Decade (3D Retrospective Reel)</span>
          </span>
        </h2>
        <span style="font-size: 0.85rem; color: var(--gold-soft); font-weight: 600; opacity: 0.85;">
          <i class="fa-solid fa-hand-pointer" style="margin-right: 4px;"></i> Drag or Scroll 3D Cards →
        </span>
      </div>

      <div class="crazy-reel-wrapper">
        <button class="crazy-reel-nav-btn prev" aria-label="Previous Slide">
          <i class="fa-solid fa-chevron-left"></i>
        </button>

        <div class="crazy-reel-container">
          <% glimpsesData.forEach(item=> { %>
            <% if (!item.hideFromReel) { %>
            <div class="crazy-reel-card gold-motion-frame" data-lightbox data-lightbox-src="<%= item.image %>"
              data-lightbox-title="<%= item.titleMr || item.title %> (वर्ष <%= item.year %>)"
              data-lightbox-title-mr="<%= item.titleMr || item.title %> (वर्ष <%= item.year %>)"
              data-lightbox-title-en="<%= item.titleEn || item.title %> (Year <%= item.year %>)"
              data-lightbox-caption="<%= item.descMr || item.desc %>"
              data-lightbox-caption-mr="<%= item.descMr || item.desc %>"
              data-lightbox-caption-en="<%= item.descEn || item.desc %>">
              <div class="card-img-box" style="display: flex;">
                <% if (item.images && item.images.length > 0) { %>
                  <% item.images.forEach(img => { %>
                    <img src="<%= img %>" alt="<%= item.titleMr || item.title %>" loading="lazy" style="width: <%= 100/item.images.length %>%; height: 100%; object-fit: cover;">
                  <% }) %>
                <% } else { %>
                  <img src="<%= item.image %>" alt="<%= item.titleMr || item.title %>" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;">
                <% } %>
                <div class="year-badge"><span class="lang-mr">वर्ष</span><span class="lang-en">Year</span>
                  <%= item.year %>
                </div>
                <div class="enlarge-hint">
                  <i class="fa-solid fa-magnifying-glass-plus" style="color: var(--royal-gold); margin-right: 4px;"></i>
                  <span class="lang-mr">झूम करा</span>
                  <span class="lang-en">Enlarge</span>
                </div>
              </div>
              <div class="card-content">
                <h4 class="card-title"><span class="lang-mr">
                    <%= item.titleMr || item.title %>
                  </span><span class="lang-en">
                    <%= item.titleEn || item.title %>
                  </span></h4>
                <p class="card-subtitle"><span class="lang-mr">
                    <%= item.themeMr || item.theme %>
                  </span><span class="lang-en">
                    <%= item.themeEn || item.theme %>
                  </span></p>
              </div>
            </div>
            <% } %>
            <% }); %>
        </div>

        <button class="crazy-reel-nav-btn next" aria-label="Next Slide">
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>
    </div>
  </section>

  <!-- Gallery Filter Bar & Grid -->
  <section class="main-content-gradient" style="padding: 4rem 0;">
    <div class="container">

      <!-- Bell Timeline Styles -->
      <svg style="width:0;height:0;position:absolute;" aria-hidden="true" focusable="false">
        <linearGradient id="gold-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#D4AF37" />
          <stop offset="50%" stop-color="#FFF2CD" />
          <stop offset="100%" stop-color="#AA7C11" />
        </linearGradient>
      </svg>
      <style>
        /* Modak Timeline Outer Wrapper */
        .modak-timeline-wrapper {
          position: relative;
          max-width: 980px;
          margin: 0 auto;
          background: transparent;
          padding: 1rem 0;
          display: flex;
          align-items: center;
          justify-content: center;
        }

        /* Draggable & Scrollable Modak Track */
        .modak-timeline-container {
          display: flex;
          align-items: center;
          overflow-x: auto;
          gap: 2.8rem;
          padding: 1.2rem 1.5rem;
          width: 100%;
          scrollbar-width: none;
          -ms-overflow-style: none;
          position: relative;
          cursor: grab;
          user-select: none;
          -webkit-user-select: none;
          scroll-behavior: smooth;
          mask-image: linear-gradient(to right, transparent 0%, black 14%, black 86%, transparent 100%);
          -webkit-mask-image: linear-gradient(to right, transparent 0%, black 14%, black 86%, transparent 100%);
        }
        .modak-timeline-container::-webkit-scrollbar {
          display: none;
        }
        .modak-timeline-container.is-dragging {
          cursor: grabbing;
          scroll-behavior: auto;
        }

        /* Individual Modak Wrapper */
        .modak-wrapper {
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          cursor: pointer;
          position: relative;
          min-width: 82px;
          z-index: 2;
          transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.25s ease;
          outline: none;
        }
        .modak-wrapper:hover {
          transform: translateY(-5px);
        }

        /* Modak Icon Box */
        .modak-icon-box {
          position: relative;
          width: 78px;
          height: 78px;
          display: flex;
          align-items: center;
          justify-content: center;
          border-radius: 50%;
        }
        
        /* Perfectly Circular Glow */
        .modak-icon-box::before {
          content: "";
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          width: 50%;
          height: 50%;
          border-radius: 50%;
          background: radial-gradient(circle, rgba(255,223,115,0.8) 0%, rgba(212,175,55,0) 70%);
          opacity: 0;
          transition: all 0.4s ease;
          z-index: -1;
        }

        .modak-img {
          position: absolute;
          max-width: 100%;
          max-height: 100%;
          object-fit: contain;
          pointer-events: none;
          transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .modak-cream {
          width: 52px;
          height: auto;
          opacity: 1;
          transform: scale(1);
        }
        .modak-gold {
          width: 78px;
          height: auto;
          opacity: 0;
          transform: scale(0.65);
        }

        /* ACTIVE MODAK */
        .modak-wrapper.active {
          transform: translateY(-6px) scale(1.18);
        }
        .modak-wrapper.active .modak-cream {
          opacity: 0;
          transform: scale(0.4);
        }
        .modak-wrapper.active .modak-gold {
          opacity: 1;
          transform: scale(1.15);
        }
        .modak-wrapper.active .modak-icon-box::before {
          opacity: 1;
          animation: circularGlowPulse 2s infinite alternate ease-in-out;
        }

        @keyframes circularGlowPulse {
          0% {
            width: 70%;
            height: 70%;
            box-shadow: 0 0 15px 5px rgba(212, 175, 55, 0.6);
          }
          100% {
            width: 100%;
            height: 100%;
            box-shadow: 0 0 25px 12px rgba(255, 215, 0, 0.8);
          }
        }

        /* Year Text */
        .modak-year {
          margin-top: 10px;
          font-size: 0.95rem;
          font-weight: 700;
          color: #4A2E1B;
          transition: all 0.3s ease;
          letter-spacing: 0.5px;
        }
        .modak-wrapper.active .modak-year {
          color: #621414;
          font-size: 1.28rem;
          font-weight: 900;
          text-shadow: 0 0 1px rgba(98, 20, 20, 0.4);
          transform: translateY(2px);
        }

        @media (max-width: 768px) {
          .modak-timeline-wrapper {
            padding: 1rem 0;
          }
          .modak-timeline-container {
            gap: 2rem;
            padding: 0.8rem 0.5rem;
            mask-image: linear-gradient(to right, transparent 0%, black 18%, black 82%, transparent 100%);
            -webkit-mask-image: linear-gradient(to right, transparent 0%, black 18%, black 82%, transparent 100%);
          }
          .modak-icon-box {
            width: 64px;
            height: 64px;
          }
          .modak-cream {
            width: 42px;
          }
          .modak-gold {
            width: 64px;
          }
          .modak-wrapper.active {
            transform: translateY(-4px) scale(1.12);
          }
          .modak-year {
            font-size: 0.85rem;
          }
          .modak-wrapper.active .modak-year {
            font-size: 1.1rem;
          }
        }

        @media (max-width: 480px) {
          .modak-timeline-wrapper {
            padding: 0.5rem 0;
          }
          .modak-timeline-container {
            gap: 1.6rem;
          }
          .modak-wrapper {
            min-width: 64px;
          }
        }

        .glimpse-card-img-wrap {
          position: relative;
          height: 350px;
          overflow: hidden;
          background: #0A0A0A;
          cursor: pointer;
          display: flex;
        }
        .glimpse-card-body {
          padding: 1.2rem 1.4rem;
          flex-grow: 1;
          display: flex;
          flex-direction: column;
          justify-content: center;
        }

        /* 2-by-2 Grid: Exactly 2 photos in row 1, 2 photos in row 2 on both Laptop & Mobile */
        .grid-2x2-year {
          display: grid !important;
          grid-template-columns: repeat(2, 1fr) !important;
          gap: 2rem !important;
        }
        .grid-2x2-year .glimpse-card-img-wrap {
          height: 340px !important;
        }
        .grid-2x2-year .glimpse-card-body {
          padding: 1.1rem 1.25rem !important;
        }
        .grid-2x2-year .glimpse-card-body h3 {
          font-size: 1.2rem !important;
          margin: 0 !important;
        }

        @media (max-width: 991px) {
          .grid-2x2-year {
            gap: 1.25rem !important;
          }
          .grid-2x2-year .glimpse-card-img-wrap {
            height: 260px !important;
          }
          .grid-2x2-year .glimpse-card-body {
            padding: 0.95rem 1rem !important;
          }
        }

        @media (max-width: 768px) {
          .grid-2x2-year {
            display: grid !important;
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 0.85rem !important;
          }
          .grid-2x2-year .card-temple {
            border-radius: var(--radius-md) !important;
          }
          .grid-2x2-year .glimpse-card-img-wrap {
            height: 180px !important;
          }
          .grid-2x2-year .glimpse-card-body {
            padding: 0.75rem 0.65rem !important;
          }
          .grid-2x2-year .glimpse-card-body h3 {
            font-size: 0.95rem !important;
            margin: 0 !important;
            line-height: 1.3 !important;
          }
        }

        @media (max-width: 480px) {
          .grid-2x2-year {
            gap: 0.55rem !important;
          }
          .grid-2x2-year .glimpse-card-img-wrap {
            height: 140px !important;
          }
          .grid-2x2-year .glimpse-card-body {
            padding: 0.55rem 0.45rem !important;
          }
          .grid-2x2-year .glimpse-card-body h3 {
            font-size: 0.84rem !important;
            line-height: 1.25 !important;
          }
        }
      </style>

      <% 
        // Get unique years >= 2005 and sort them ascending for timeline
        const allYears = [...new Set(glimpsesData.map(item => item.year))].filter(y => parseInt(y, 10) >= 2005).sort((a,b) => a - b);
      %>
      
      <div style="text-align: center; margin-bottom: 2.5rem;">
        <h3 style="color: var(--gold-soft); font-size: 1.5rem; font-weight: 600; text-transform: uppercase; letter-spacing: 2px; display: flex; justify-content: center; align-items: center; gap: 10px;">
          <i class="fa-solid fa-om" style="color: var(--royal-gold);"></i>
          <span>
            <span class="lang-mr">आपला प्रवास</span>
            <span class="lang-en">Our Journey</span>
          </span>
          <i class="fa-solid fa-om" style="color: var(--royal-gold);"></i>
        </h3>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 8px;">
          <i class="fa-solid fa-hand-pointer" style="margin-right: 5px;"></i>
          <span class="lang-mr">वर्षानुसार आठवणींना उजाळा देण्यासाठी मोदकावर क्लिक करा</span>
          <span class="lang-en">Tap a modak to relive the memories</span>
        </p>
      </div>

      <div class="modak-timeline-wrapper">
        <!-- Modak Draggable / Scrollable Track -->
        <div class="modak-timeline-container" id="modakTimeline">
          
          <% allYears.forEach((year, index) => { %>
            <div class="modak-wrapper year-btn" data-filter="<%= year %>" tabindex="0">
              <div class="modak-icon-box">
                <img src="/images/modak_cream_hd.png" class="modak-img modak-cream" alt="Modak <%= year %>" draggable="false">
                <img src="/images/modak_gold_hd.png" class="modak-img modak-gold" alt="Golden Modak <%= year %>" draggable="false">
              </div>
              <span class="modak-year"><%= year %></span>
            </div>
          <% }); %>
        </div>
      </div>

      <div class="year-contents-wrapper" style="max-width: 1000px; margin: 0 auto;">
        <% allYears.forEach(year => { %>
          <div class="year-content" data-content-year="<%= year %>" style="display: none; padding: 2rem 0;">
            <div class="<%= (year === '2012' || year === '2013' || year === '2014' || year === '2015' || year === '2016' || year === '2017' || year === '2018' || glimpsesData.filter(item => item.year === year).length === 4) ? 'grid-2x2-year' : 'grid-3' %>">
              <% glimpsesData.filter(item => item.year === year).forEach(item => { %>
                <div class="card-temple gallery-card-item gold-motion-frame reveal-on-scroll"
                  data-category="<%= item.category %>"
                  style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
                  <div class="glimpse-card-img-wrap"
                    data-lightbox data-lightbox-src="<%= item.image || (item.images && item.images[0]) %>"
                    data-lightbox-title="<%= item.titleMr || item.title %> (वर्ष <%= item.year %>)"
                    data-lightbox-title-mr="<%= item.titleMr || item.title %> (वर्ष <%= item.year %>)"
                    data-lightbox-title-en="<%= item.titleEn || item.title %> (Year <%= item.year %>)"
                    data-lightbox-caption="<%= item.descMr || item.desc %>"
                    data-lightbox-caption-mr="<%= item.descMr || item.desc %>"
                    data-lightbox-caption-en="<%= item.descEn || item.desc %>">
                    <% if (item.images && item.images.length > 0) { %>
                      <% item.images.forEach(img => { %>
                        <img src="<%= img %>" alt="<%= item.title %>" style="width: <%= 100/item.images.length %>%; height: 100%; object-fit: cover;">
                      <% }) %>
                    <% } else { %>
                      <img src="<%= item.image %>" alt="<%= item.title %>" style="width: 100%; height: 100%; object-fit: cover;">
                    <% } %>
                  </div>
                  <div class="glimpse-card-body">
                    <div>
                      <h3 style="font-size: 1.18rem; color: var(--temple-maroon); margin-bottom: 0; line-height: 1.35;"><span
                          class="lang-mr">
                          <%= item.titleMr || item.title %>
                        </span><span class="lang-en">
                          <%= item.titleEn || item.title %>
                        </span></h3>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const timeline = document.getElementById('modakTimeline');
      const yearBtns = Array.from(document.querySelectorAll('.modak-wrapper.year-btn'));
      const yearContents = document.querySelectorAll('.year-content');

      // Update fade in / fade out for modaks while dragging / scrolling
      function updateModakFade() {
        if (!timeline) return;
        const containerRect = timeline.getBoundingClientRect();
        const containerCenter = containerRect.left + containerRect.width / 2;
        const maxDist = containerRect.width / 2;

        yearBtns.forEach(btn => {
          const rect = btn.getBoundingClientRect();
          const itemCenter = rect.left + rect.width / 2;
          const dist = Math.abs(itemCenter - containerCenter);
          const ratio = Math.min(dist / maxDist, 1);

          // Fade in toward center (1.0), fade out toward edges (0.3)
          let opacity = 1 - (ratio * 0.68);
          if (btn.classList.contains('active')) {
            opacity = 1.0;
          } else {
            opacity = Math.max(0.3, opacity);
          }
          btn.style.opacity = opacity.toFixed(2);
        });
      }

      // Smoothly center a modak item in the timeline track
      function centerModak(btn, smooth = true) {
        if (!btn || !timeline) return;
        const btnLeft = btn.offsetLeft;
        const btnWidth = btn.offsetWidth;
        const containerWidth = timeline.clientWidth;
        const targetScroll = btnLeft - (containerWidth / 2) + (btnWidth / 2);
        timeline.scrollTo({
          left: Math.max(0, targetScroll),
          behavior: smooth ? 'smooth' : 'auto'
        });
      }

      // Activate a specific year
      function activateYear(selectedYear, shouldScrollTimeline = true, shouldScrollToContent = false) {
        const btn = yearBtns.find(b => b.getAttribute('data-filter') === selectedYear);
        const contentToShow = document.querySelector(`.year-content[data-content-year="${selectedYear}"]`);
        if (!btn || !contentToShow) return;

        // Hide other contents and reset active class
        yearContents.forEach(content => content.style.display = 'none');
        yearBtns.forEach(b => b.classList.remove('active'));

        // Activate selected modak and content
        btn.classList.add('active');
        contentToShow.style.display = 'block';

        // Re-trigger reveal animation for items inside this content block
        const items = contentToShow.querySelectorAll('.gallery-card-item');
        items.forEach((item, index) => {
          item.classList.remove('revealed');
          setTimeout(() => item.classList.add('revealed'), 45 * index);
        });

        if (shouldScrollTimeline) {
          centerModak(btn, true);
        }

        if (shouldScrollToContent) {
          setTimeout(() => {
            contentToShow.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 300);
        }

        setTimeout(updateModakFade, 60);
        setTimeout(updateModakFade, 350);
      }

      // Drag to scroll physics for mouse and touch
      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;
      let hasDragged = false;

      if (timeline) {
        timeline.addEventListener('mousedown', (e) => {
          isDown = true;
          hasDragged = false;
          timeline.classList.add('is-dragging');
          startX = e.pageX - timeline.offsetLeft;
          scrollLeft = timeline.scrollLeft;
        });

        window.addEventListener('mouseup', () => {
          if (isDown) {
            isDown = false;
            timeline.classList.remove('is-dragging');
            updateModakFade();
          }
        });

        timeline.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          const x = e.pageX - timeline.offsetLeft;
          const walk = (x - startX) * 1.5;
          if (Math.abs(walk) > 5) {
            hasDragged = true;
          }
          timeline.scrollLeft = scrollLeft - walk;
          updateModakFade();
        });

        timeline.addEventListener('scroll', () => {
          updateModakFade();
        }, { passive: true });

        timeline.addEventListener('touchmove', () => {
          updateModakFade();
        }, { passive: true });

        timeline.addEventListener('touchend', () => {
          setTimeout(updateModakFade, 50);
        }, { passive: true });
      }

      // Modak Click Handler
      yearBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          if (hasDragged) {
            hasDragged = false;
            return; // Prevent click when dragging
          }
          const selectedYear = btn.getAttribute('data-filter');
          activateYear(selectedYear, true, true);
        });
      });

      // Initialize default active year (2012)
      const initialYear = yearBtns.some(b => b.getAttribute('data-filter') === '2012')
        ? '2012'
        : (yearBtns[0] ? yearBtns[0].getAttribute('data-filter') : null);

      if (initialYear) {
        activateYear(initialYear, false, false);
        setTimeout(() => {
          const initialBtn = yearBtns.find(b => b.getAttribute('data-filter') === initialYear);
          centerModak(initialBtn, false);
          updateModakFade();
        }, 120);
      }

      window.addEventListener('resize', updateModakFade);
    });
  </script>

  <%- include('partials/footer') %>